root@ip-10-1-1-75:~# 
root@ip-10-1-1-75:~# 
root@ip-10-1-1-75:~# 
root@ip-10-1-1-75:~# 

under system > you'll find something called ThinBackup Configuration > give the location and cron for scheduling the backup 

You'll see something like this

root@ip-10-1-1-75:~# cd /jenkins-backup/
root@ip-10-1-1-75:/jenkins-backup# ls -ltr
total 4
drwxr-xr-x 5 jenkins jenkins 4096 Feb  5 12:44 FULL-2026-02-05_12-44
root@ip-10-1-1-75:/jenkins-backup# 

